{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/api/auth/v2/login/otp/send",
      "destination": "https://prod-api.nnlone.com/auth/v2/login/otp/send/"
    },
    {
      "source": "/api/auth/v2/login/otp/send/",
      "destination": "https://prod-api.nnlone.com/auth/v2/login/otp/send/"
    },
    {
      "source": "/api/auth/login/otp/validate",
      "destination": "https://prod-api.nnlone.com/auth/login/otp/validate/"
    },
    {
      "source": "/api/auth/login/otp/validate/",
      "destination": "https://prod-api.nnlone.com/auth/login/otp/validate/"
    },
    {
      "source": "/api/auth/token/refresh",
      "destination": "https://prod-api.nnlone.com/auth/token/refresh/"
    },
    {
      "source": "/api/auth/token/refresh/",
      "destination": "https://prod-api.nnlone.com/auth/token/refresh/"
    },
    {
      "source": "/api/cms/v2/live_classes",
      "destination": "https://prod-api.nnlone.com/cms/v2/live_classes/"
    },
    {
      "source": "/api/cms/v2/live_classes/",
      "destination": "https://prod-api.nnlone.com/cms/v2/live_classes/"
    },
    {
      "source": "/api/cms/v2/live_classes_recordings",
      "destination": "https://prod-api.nnlone.com/cms/v2/live_classes_recordings/"
    },
    {
      "source": "/api/cms/v2/live_classes_recordings/",
      "destination": "https://prod-api.nnlone.com/cms/v2/live_classes_recordings/"
    },
    {
      "source": "/api/cms/v2/live_classes/:id",
      "destination": "https://prod-api.nnlone.com/cms/v2/live_classes/:id/"
    },
    {
      "source": "/api/cms/v2/live_classes/:id/",
      "destination": "https://prod-api.nnlone.com/cms/v2/live_classes/:id/"
    },
    {
      "source": "/zoom-subdomain/:subdomain/:path*",
      "destination": "https://nightingale-9n2c.onrender.com/zoom-subdomain/:subdomain/:path*"
    },
    {
      "source": "/zoom-subdomain/:subdomain/:path*/",
      "destination": "https://nightingale-9n2c.onrender.com/zoom-subdomain/:subdomain/:path*"
    },
    {
      "source": "/zoom/:path*",
      "destination": "https://nightingale-9n2c.onrender.com/zoom/:path*"
    },
    {
      "source": "/zoom/:path*/",
      "destination": "https://nightingale-9n2c.onrender.com/zoom/:path*"
    },
    {
      "source": "/captcha-image",
      "destination": "https://nightingale-9n2c.onrender.com/captcha-image"
    },
    {
      "source": "/captcha-audio",
      "destination": "https://nightingale-9n2c.onrender.com/captcha-audio"
    },
    {
      "source": "/captcha/:path*",
      "destination": "https://nightingale-9n2c.onrender.com/captcha/:path*"
    },
    {
      "source": "/csrf_js",
      "destination": "https://nightingale-9n2c.onrender.com/csrf_js"
    },
    {
      "source": "/csrf_data",
      "destination": "https://nightingale-9n2c.onrender.com/csrf_data"
    },
    {
      "source": "/csrf/:path*",
      "destination": "https://nightingale-9n2c.onrender.com/csrf/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://prod-api.nnlone.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, Content-Type, Accept" }
      ]
    }
  ]
}
